{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(npx supabase *)",
      "Bash(npx vercel *)",
      "Bash(npm *)",
      "Bash(node *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__(apply_migration|execute_sql)",
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/.claude/hooks/candado_esquemas.py\""
          }
        ]
      }
    ]
  }
}